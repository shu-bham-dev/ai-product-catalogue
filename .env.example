# Backend Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Product Data Source: "fakestore" (calls FakeStoreAPI with cache/fallback) or "local" (in-memory mock)
PRODUCT_DATA_SOURCE=fakestore
FAKE_STORE_API_URL=https://fakestoreapi.com

# Email Service Provider: "memory" (stores in memory & exposes dev mailbox), "console", or "smtp"
EMAIL_PROVIDER=memory
SALES_INBOX_EMAIL=sales@catalogue.example.com

# SMTP settings (only needed when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api
